      { "name": "user" },
      { "name": "admin" }
    ]
  },
  "clientScopes": [
    {
      "name": "profile-scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    }
  ]
